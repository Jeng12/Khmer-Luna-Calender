APP_NAME="Khmer Lunar Calendar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khmer_calendar
DB_USERNAME=root
DB_PASSWORD=

# ── Cache (use Redis in production) ────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=sync

# ── Sanctum ────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8081,localhost:3000

# ── Firebase / FCM (for push notifications) ────────────────────────────────
FCM_SERVER_KEY=

# ── Chhankitek ────────────────────────────────────────────────────────────
# No extra env needed — package uses hard-coded lunar tables.
# Install: composer require asorasoft/chhankitek
